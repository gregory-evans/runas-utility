%% Блок-схема работы RunAs Utility
%% Файл: run.mmd
%% Просмотр: https://mermaid.live  или любой Mermaid-рендерер

flowchart TD
    Start([Запуск run.exe]) --> CheckElevated{Параметр<br/>--elevated?}

    %% ---- Ветка обычного запуска ----
    CheckElevated -- Нет --> NormalStart[NormalStart]
    NormalStart --> CheckParams{Есть<br/>параметры?}
    CheckParams -- Нет --> PrintHelp[Вывод справки<br/>exit 102]
    PrintHelp --> EndNormal([Выход])

    CheckParams -- Да --> ParseArgs[Парсинг аргументов<br/>mode, elevation, command, params]
    ParseArgs --> NeedElev{Флаг -a?}

    NeedElev -- Нет --> RunDirect[RunCommand<br/>CreateProcess]
    RunDirect --> EndNormal

    NeedElev -- Да --> CheckAdmin{Уже админ?<br/>IsRunningAsAdmin}

    CheckAdmin -- Да --> RunDirect2[RunCommand<br/>CreateProcess]
    RunDirect2 --> EndNormal

    %% ---- Ветка повышения прав ----
    CheckAdmin -- Нет --> CreateMMF[Создать MMF<br/>Local\mmf_<PID>]
    CreateMMF --> WriteMMF[Записать команду<br/>в MMF]
    WriteMMF --> CreateEvent[Создать Event<br/>Global\event_<PID><br/>несигнальный]
    CreateEvent --> ShellExec[ShellExecuteEx<br/>runas себя + --elevated<br/>+ имена MMF / Event]
    ShellExec --> WaitEvent[Ожидание Event<br/>таймаут 10 сек]
    WaitEvent --> CloseHandles[Закрыть Event + MMF]
    CloseHandles --> EndNormal

    %% ---- Ветка elevated запуска ----
    CheckElevated -- Да --> ElevatedStart[ElevatedStart]
    ElevatedStart --> ParseElevated[Извлечь параметры<br/>mmfName, eventName, mode]
    ParseElevated --> OpenMMF[Открыть MMF<br/>OpenFileMapping]
    OpenMMF --> ReadMMF[Прочитать команду<br/>из MMF]
    ReadMMF --> CloseMMF[Закрыть MMF]
    CloseMMF --> OpenEvent[Открыть Event<br/>OpenEvent]
    OpenEvent --> SetEvent[SetEvent<br/>сигнал родителю]
    SetEvent --> CloseEvent[Закрыть Event]
    CloseEvent --> RunElevated[RunCommand<br/>CreateProcess<br/>с правами админа]
    RunElevated --> EndElevated([Выход])

    %% ---- Стили ----
    classDef elevated fill:#ff6b6b,stroke:#c0392b,color:#fff
    classDef normal fill:#48dbfb,stroke:#0abde3,color:#fff
    classDef decision fill:#feca57,stroke:#f39c12,color:#000
    classDef io fill:#55efc4,stroke:#00b894,color:#000
    classDef error fill:#ff4757,stroke:#c0392b,color:#fff

    class ElevatedStart,ParseElevated,OpenMMF,ReadMMF,CloseMMF,OpenEvent,SetEvent,CloseEvent,RunElevated elevated
    class NormalStart,ParseArgs,RunDirect,RunDirect2 normal
    class CheckElevated,CheckParams,NeedElev,CheckAdmin decision
    class Start,EndNormal,EndElevated io
    class PrintHelp error
